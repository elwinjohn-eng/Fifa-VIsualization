
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXORA | Beyond Imagination</title>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #080914;
    color: white;
    overflow-x: hidden;
}

/* Background */
.background {
    position: fixed;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
}

.orb {
    position: absolute;
    width: 450px;
    height: 450px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
    animation: float 9s infinite alternate ease-in-out;
}

.orb1 {
    background: #773cff;
    top: -150px;
    left: -100px;
}

.orb2 {
    background: #087bff;
    bottom: -180px;
    right: -100px;
    animation-delay: 2s;
}

@keyframes float {
    from { transform: translate(0, 0); }
    to { transform: translate(100px, 70px); }
}

/* Navigation */
nav {
    width: 90%;
    max-width: 1200px;
    margin: 25px auto;
    padding: 17px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    backdrop-filter: blur(20px);
    position: sticky;
    top: 15px;
    z-index: 100;
}

.logo {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 2px;
    background: linear-gradient(90deg,#a98aff,#48baff);
    -webkit-background-clip: text;
    color: transparent;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 35px;
}

nav ul a {
    text-decoration: none;
    color: #b8b8ca;
    transition: 0.3s;
}

nav ul a:hover {
    color: white;
}

.nav-btn {
    background: linear-gradient(90deg,#7952ff,#397bff);
    padding: 11px 22px;
    border-radius: 10px;
    text-decoration: none;
    color: white;
    font-weight: 600;
    transition: 0.3s;
}

.nav-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 25px #684cff80;
}

/* Hero */
.hero {
    min-height: 650px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 100px 20px;
}

.tag {
    padding: 9px 18px;
    border: 1px solid #8c73ff66;
    border-radius: 30px;
    color: #b8a7ff;
    background: #8c73ff12;
    margin-bottom: 28px;
    font-size: 13px;
    letter-spacing: 1px;
}

.hero h1 {
    font-size: clamp(45px, 7vw, 85px);
    line-height: 1.08;
    max-width: 950px;
    font-weight: 800;
}

.gradient-text {
    background: linear-gradient(90deg,#9b7aff,#4ebeff,#a47aff);
    -webkit-background-clip: text;
    color: transparent;
}

.hero p {
    color: #a4a5b9;
    max-width: 620px;
    line-height: 1.8;
    margin: 25px 0 35px;
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
}

.primary-btn, .secondary-btn {
    padding: 16px 30px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
}

.primary-btn {
    background: linear-gradient(90deg,#7952ff,#397bff);
    color: white;
    box-shadow: 0 5px 30px #7952ff40;
}

.secondary-btn {
    border: 1px solid #ffffff35;
    color: white;
    background: #ffffff08;
}

.primary-btn:hover, .secondary-btn:hover {
    transform: translateY(-5px);
}

/* Stats */
.stats {
    max-width: 1000px;
    width: 90%;
    margin: 0 auto 120px;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    text-align: center;
    gap: 20px;
}

.stat h2 {
    font-size: 42px;
    color: #a78bff;
}

.stat p {
    color: #9293a9;
    margin-top: 8px;
}

/* Features */
.features {
    padding: 80px 8%;
    background: #ffffff05;
    border-top: 1px solid #ffffff12;
}

.section-heading {
    text-align: center;
    margin-bottom: 55px;
}

.section-heading h2 {
    font-size: 45px;
    margin-bottom: 15px;
}

.section-heading p {
    color: #999aaf;
}

.feature-grid {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.card {
    padding: 35px 28px;
    border: 1px solid #ffffff15;
    background: linear-gradient(145deg,#ffffff0c,#ffffff03);
    border-radius: 20px;
    transition: 0.4s;
}

.card:hover {
    transform: translateY(-10px);
    border-color: #8d70ff;
    box-shadow: 0 15px 40px #7350ff20;
}

.card-icon {
    font-size: 35px;
    margin-bottom: 25px;
}

.card h3 {
    font-size: 22px;
    margin-bottom: 15px;
}

.card p {
    color: #a1a1b3;
    line-height: 1.8;
}

/* CTA */
.cta {
    text-align: center;
    padding: 110px 20px;
}

.cta h2 {
    font-size: clamp(35px,5vw,55px);
    margin-bottom: 20px;
}

.cta p {
    color: #a4a5b9;
    margin-bottom: 35px;
}

/* Footer */
footer {
    padding: 30px;
    text-align: center;
    color: #77788d;
    border-top: 1px solid #ffffff15;
}

/* Mobile */
@media(max-width: 800px) {
    nav ul {
        display: none;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .hero {
        min-height: 550px;
    }

    .section-heading h2 {
        font-size: 34px;
    }
}
</style>
</head>

<body>

<div class="background">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
</div>

<!-- Navigation -->
<nav>
    <div class="logo">NEXORA.</div>

    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#about">About</a></li>
    </ul>

    <a href="#contact" class="nav-btn">Get Started ↗</a>
</nav>

<!-- Hero -->
<section class="hero" id="home">

    <div class="tag">✦ THE FUTURE STARTS HERE</div>

    <h1>
        Think Beyond.<br>
        <span class="gradient-text">Create Infinity.</span>
    </h1>

    <p>
        Welcome to a world where creativity meets technology.
        Explore new possibilities, discover extraordinary ideas,
        and experience the future of digital innovation.
    </p>

    <div class="hero-buttons">
        <a href="#features" class="primary-btn">Explore More →</a>
        <a href="#about" class="secondary-btn">Discover Us</a>
    </div>

</section>

<!-- Statistics -->
<section class="stats" id="about">

    <div class="stat">
        <h2>10K+</h2>
        <p>Creative Minds</p>
    </div>

    <div class="stat">
        <h2>150+</h2>
        <p>Global Projects</p>
    </div>

    <div class="stat">
        <h2>99%</h2>
        <p>Innovation Focus</p>
    </div>

</section>

<!-- Features -->
<section class="features" id="features">

    <div class="section-heading">
        <h2>Explore the <span class="gradient-text">Possibilities</span></h2>
        <p>Everything you need to imagine, innovate and create.</p>
    </div>

    <div class="feature-grid">

        <div class="card">
            <div class="card-icon">🚀</div>
            <h3>Innovation</h3>
            <p>
                Discover revolutionary ideas and transform
                ambitious concepts into extraordinary experiences.
            </p>
        </div>

        <div class="card">
            <div class="card-icon">💎</div>
            <h3>Premium Design</h3>
            <p>
                Experience elegant interfaces, modern aesthetics
                and beautiful digital experiences.
            </p>
        </div>

        <div class="card">
            <div class="card-icon">🌐</div>
            <h3>Global Vision</h3>
            <p>
                Connect ideas, explore opportunities and
                build something that reaches beyond boundaries.
            </p>
        </div>

    </div>

</section>

<!-- Call to Action -->
<section class="cta" id="contact">

    <h2>Ready to Explore <span class="gradient-text">More?</span></h2>

    <p>
        Your next great idea could begin right here.
        Let's create something extraordinary.
    </p>

    <a href="#home" class="primary-btn">Back to Top ↑</a>

</section>

<!-- Footer -->
<footer>
    <p>© 2026 NEXORA. All Rights Reserved.</p>
    <p style="margin-top:10px;">Designed for the Future ✦</p>
</footer>

<script>

// Smooth entrance animation
const cards = document.querySelectorAll(".card");

const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
        if(entry.isIntersecting) {
            entry.target.style.opacity = "1";
            entry.target.style.transform = "translateY(0)";
        }
    });
}, { threshold: 0.2 });

cards.forEach(card => {
    card.style.opacity = "0";
    card.style.transform = "translateY(30px)";
    card.style.transition = "all 0.8s ease";
    observer.observe(card);
});

// Interactive button message
document.querySelector(".nav-btn").addEventListener("click", () => {
    console.log("Welcome to NEXORA!");
});

</script>

</body>
</html>
